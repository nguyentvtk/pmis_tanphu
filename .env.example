# Chỉ phía máy chủ
GAS_EXEC_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Phía trình duyệt (cùng Client ID; không bí mật)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Tuỳ chọn: địa chỉ VGCA Web Signer trên máy người dùng
NEXT_PUBLIC_VGCA_URL=

# Tuỳ chọn: bật đọc Gantt trực tiếp từ Supabase (để trống → dùng GAS/Sheets như cũ).
# Cần cấu hình Google là Auth provider trong Supabase (cùng Google Client ID của app).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
